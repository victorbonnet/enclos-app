<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The bridge, over the tailnet -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Whether the network is metered (mobile data): a large file then
         waits for a tap instead of coming by itself -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- No backup and no transfer to a new phone: the app holds device keys
         and will hold conversations. allowBackup="false" and
         fullBackupContent cover Android 11 and older; dataExtractionRules
         covers 12 and later, where allowBackup no longer stops
         device-to-device transfer. -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="enclos"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.Enclos"
        tools:targetApi="33">
        <!-- adjustResize: the screen follows the keyboard as it slides,
             frame by frame, instead of jumping once it is up.
             configChanges uiMode: switching light and dark, by the system
             or in the app, crossfades the screen instead of recreating it -->

        <activity
            android:name=".MainActivity"
            android:configChanges="uiMode"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- The QR code scanner, which the library locks to landscape: it
             follows how the phone is held instead -->
        <activity
            android:name="com.journeyapps.barcodescanner.CaptureActivity"
            android:screenOrientation="fullSensor"
            tools:replace="screenOrientation" />
        <!-- Shares a message's file with another app, which may read that
             one file only (res/xml/shared_files.xml) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/shared_files" />
        </provider>
    </application>

</manifest>
