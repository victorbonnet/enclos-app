<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The bridge, over the tailnet -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- No backup and no transfer to a new phone: the app holds device keys
         and will hold conversations. allowBackup="false" and
         fullBackupContent cover Android 11 and older; dataExtractionRules
         covers 12 and later, where allowBackup no longer stops
         device-to-device transfer. -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="Enclos"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.Enclos"
        tools:targetApi="33">
        <!-- Portrait only, for now: landscape comes later. Android 16 and
             later ignore the lock on large screens (tablets, foldables
             open), where the app then turns with the screen.
             adjustResize: the screen follows the keyboard as it slides,
             frame by frame, instead of jumping once it is up -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            tools:ignore="DiscouragedApi,LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- The QR code scanner, which the library locks to landscape:
             portrait, as the rest of the app -->
        <activity
            android:name="com.journeyapps.barcodescanner.CaptureActivity"
            android:screenOrientation="portrait"
            tools:ignore="DiscouragedApi,LockedOrientationActivity"
            tools:replace="screenOrientation" />
    </application>

</manifest>
